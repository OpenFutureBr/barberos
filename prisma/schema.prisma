// ─────────────────────────────────────────────────────────────
// BarberOS — Schema Prisma v1.3
// PRD v1.3 · Todas as entidades mapeadas
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}

enum Role {
  ADMIN
  MANAGER
  BARBER_CLT
  BARBER_MEI
  AUTONOMO
  CLIENT
}

enum EmploymentType {
  CLT
  PJ
  MEI
  PARTNER
  SOLO
}

enum Plan {
  SOLO
  START
  PRO
  BUSINESS
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_QUEUE
  IN_PROGRESS
  DONE
  CANCELLED
  NO_SHOW
}

enum ServiceType {
  PRESENTIAL
  HOME_VISIT
}

enum PaymentMethod {
  PIX
  CASH
  CARD
  CASHBACK
  SUBSCRIPTION
}

enum PixStatus {
  PENDING
  PAID
  EXPIRED
  REFUNDED
}

enum SplitType {
  SPLIT_ESTABLISHMENT
  DIRECT_PROFESSIONAL
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  OVERDUE
}

enum LoyaltyLevel {
  BRONZE
  SILVER
  GOLD
  VIP
}

enum ClientSegment {
  NEW
  REGULAR
  AT_RISK
  INACTIVE
  VIP
}

model Establishment {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(START)
  logoUrl   String?
  phone     String?
  email     String?
  address   String?
  city      String?
  state     String?
  zipCode   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  clients           Client[]
  services          Service[]
  products          Product[]
  appointments      Appointment[]
  cashRegisters     CashRegister[]
  haircuts          Haircut[]
  subscriptionPlans SubscriptionPlan[]

  @@map("establishments")
}

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  emailVerified  DateTime?
  image          String?
  role           Role           @default(BARBER_CLT)
  employmentType EmploymentType @default(CLT)
  phone          String?
  isActive       Boolean        @default(true)
  commissionPct  Float?
  benchFee       Float?
  benchFeePct    Float?
  bookingSlug    String?        @unique
  serviceZoneKm  Float?
  serviceZoneAreas String[]
  homeAddress    String?

  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id])
  kitItems        KitItem[]
  appointments    Appointment[]
  accounts        Account[]
  sessions        Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Client {
  id               String        @id @default(cuid())
  name             String
  phone            String
  email            String?
  birthDate        DateTime?
  photoUrl         String?
  isActive         Boolean       @default(true)
  faceShape        String?
  aiAnalysedAt     DateTime?
  homeAddress      String?
  homeCity         String?
  homeZipCode      String?
  homeLat          Float?
  homeLng          Float?
  cashbackBalance  Float         @default(0)
  loyaltyPoints    Int           @default(0)
  loyaltyLevel     LoyaltyLevel  @default(BRONZE)
  segment          ClientSegment @default(NEW)
  avgVisitInterval Int?
  lastVisitAt      DateTime?
  totalSpent       Float         @default(0)

  establishmentId String
  establishment   Establishment   @relation(fields: [establishmentId], references: [id])
  appointments    Appointment[]
  productSales    ProductSale[]
  loyaltyAccount  LoyaltyAccount?
  subscription    Subscription?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([phone, establishmentId])
  @@map("clients")
}

model Service {
  id            String  @id @default(cuid())
  name          String
  description   String?
  price         Float
  durationMin   Int
  category      String?
  isActive      Boolean @default(true)
  availableHome Boolean @default(false)

  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  appointments    Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("services")
}

model Haircut {
  id              String   @id @default(cuid())
  name            String
  description     String?
  photoUrl        String
  instructions    String?  @db.Text
  durationMin     Int?
  difficulty      String?
  tags            String[]
  isActive        Boolean  @default(true)
  faceShapeCompat Json?

  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  appointments    Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("haircuts")
}

model Appointment {
  id            String            @id @default(cuid())
  status        AppointmentStatus @default(SCHEDULED)
  serviceType   ServiceType       @default(PRESENTIAL)
  scheduledAt   DateTime
  startedAt     DateTime?
  finishedAt    DateTime?
  notes         String?
  clientAddress String?
  clientCity    String?
  clientLat     Float?
  clientLng     Float?
  distanceKm    Float?
  travelFee     Float?

  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])
  professionalId  String
  professional    User          @relation(fields: [professionalId], references: [id])
  serviceId       String
  service         Service       @relation(fields: [serviceId], references: [id])
  haircutId       String?
  haircut         Haircut?      @relation(fields: [haircutId], references: [id])
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  payment         Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("appointments")
}

model Payment {
  id                String        @id @default(cuid())
  method            PaymentMethod
  amount            Float
  pixQrCode         String?       @db.Text
  pixCopyPaste      String?       @db.Text
  pixTxId           String?       @unique
  pixStatus         PixStatus     @default(PENDING)
  pixPaidAt         DateTime?
  splitType         SplitType     @default(SPLIT_ESTABLISHMENT)
  splitEstabAmount  Float?
  splitProfAmount   Float?
  cashbackGenerated Float         @default(0)

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

model CashRegister {
  id            String    @id @default(cuid())
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  openingAmount Float     @default(0)
  closingAmount Float?
  totalRevenue  Float     @default(0)
  totalExpenses Float     @default(0)
  notes         String?

  establishmentId String
  establishment   Establishment  @relation(fields: [establishmentId], references: [id])
  transactions    Transaction[]

  @@map("cash_registers")
}

model Transaction {
  id          String   @id @default(cuid())
  type        String
  amount      Float
  description String?
  method      String?
  createdAt   DateTime @default(now())

  cashRegisterId String
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id])

  @@map("transactions")
}

model Product {
  id          String  @id @default(cuid())
  name        String
  sku         String?
  barcode     String?
  costPrice   Float
  salePrice   Float
  stock       Int     @default(0)
  minStock    Int     @default(5)
  unit        String  @default("un")
  supplier    String?
  isActive    Boolean @default(true)

  establishmentId String
  establishment   Establishment   @relation(fields: [establishmentId], references: [id])
  stockMovements  StockMovement[]
  sales           ProductSale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model StockMovement {
  id        String   @id @default(cuid())
  type      String
  quantity  Int
  reason    String?
  createdAt DateTime @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@map("stock_movements")
}

model ProductSale {
  id        String   @id @default(cuid())
  quantity  Int      @default(1)
  unitPrice Float
  total     Float
  createdAt DateTime @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id])
  clientId  String?
  client    Client? @relation(fields: [clientId], references: [id])

  @@map("product_sales")
}

model KitItem {
  id          String  @id @default(cuid())
  name        String
  quantity    Int     @default(0)
  minQuantity Int     @default(1)
  unit        String  @default("un")
  notes       String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("kit_items")
}

model LoyaltyAccount {
  id             String       @id @default(cuid())
  totalEarned    Float        @default(0)
  totalRedeemed  Float        @default(0)
  currentBalance Float        @default(0)
  totalPoints    Int          @default(0)
  level          LoyaltyLevel @default(BRONZE)
  expiresAt      DateTime?

  clientId     String               @unique
  client       Client               @relation(fields: [clientId], references: [id])
  transactions LoyaltyTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id          String   @id @default(cuid())
  type        String
  amount      Float
  description String?
  createdAt   DateTime @default(now())

  loyaltyAccountId String
  loyaltyAccount   LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id])

  @@map("loyalty_transactions")
}

model SubscriptionPlan {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  services    String[]
  isActive    Boolean  @default(true)

  establishmentId String
  establishment   Establishment  @relation(fields: [establishmentId], references: [id])
  subscriptions   Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscription_plans")
}

model Subscription {
  id            String             @id @default(cuid())
  status        SubscriptionStatus @default(ACTIVE)
  price         Float
  startedAt     DateTime           @default(now())
  nextBillingAt DateTime
  pausedAt      DateTime?
  cancelledAt   DateTime?
  notes         String?

  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id])
  planId   String
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

model GiftCard {
  id         String    @id @default(cuid())
  code       String    @unique
  amount     Float
  balance    Float
  isUsed     Boolean   @default(false)
  expiresAt  DateTime?
  redeemedAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("gift_cards")
}