generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Establishment {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  plan               Plan               @default(START)
  logoUrl            String?
  phone              String?
  email              String?
  address            String?
  city               String?
  state              String?
  zipCode            String?
  pixKey             String?
  whatsapp           String?
  instagram          String?
  inauguratedAt      DateTime?
  cnpj               String?
  razaoSocial        String?
  inscricaoMunicipal String?
  regimeTributario   String?
  businessHours      Json?
  cashbackConfig     Json?
  painelConfig       Json?
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  appointments       Appointment[]
  cashRegisters      CashRegister[]
  clients            Client[]
  haircuts           Haircut[]
  products           Product[]
  services           Service[]
  subscriptionPlans  SubscriptionPlan[]
  users              User[]
  pricingRules       PricingRule[]
  cashbackConfigs    CashbackConfig[]
  organizationId     String?            @map("organization_id")
  organization       Organization?      @relation(fields: [organizationId], references: [id])

  @@index([isActive], map: "idx_establishments_isActive")
  @@index([organizationId], map: "idx_establishments_organizationId")
  @@index([organizationId, isActive], map: "idx_establishments_organizationId_isActive")
  @@map("establishments")
}

model User {
  id                String           @id @default(cuid())
  name              String
  email             String           @unique
  emailVerified     DateTime?
  image             String?
  role              Role             @default(BARBER_CLT)
  employmentType    EmploymentType   @default(CLT)
  phone             String?
  isActive          Boolean          @default(true)
  commissionPct     Float?
  benchFee          Float?
  benchFeePct       Float?
  bookingSlug       String?          @unique
  serviceZoneKm     Float?
  serviceZoneAreas  String[]
  homeAddress       String?
  establishmentId   String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  accounts          Account[]
  appointments      Appointment[]
  birthDate         DateTime?
  homeNumber        String?
  homeNeighborhood  String?
  homeCity          String?
  homeZipCode       String?
  pixKey            String?
  breakBetweenAppts Int?             @default(10)
  admissionDate     DateTime?        @default(now())
  schedules         UserSchedule[]
  userServices      UserService[]
  attendsHome       Boolean          @default(false)
  username          String?          @unique
  passwordHash      String?
  isFirstLogin      Boolean          @default(true)
  kitItems          KitItem[]
  sessions          Session[]
  establishment     Establishment?   @relation(fields: [establishmentId], references: [id])
  permissions       UserPermission[]
  organizationId    String?          @map("organization_id")
  organization      Organization?    @relation(fields: [organizationId], references: [id])

  @@index([establishmentId, isActive], map: "idx_users_establishmentId_isActive")
  @@index([organizationId], map: "idx_users_organizationId")
  @@index([organizationId, role], map: "idx_users_organizationId_role")
  @@index([organizationId, establishmentId, isActive], map: "idx_users_org_estab_isActive")
  @@index([role], map: "idx_users_role")
  @@index([employmentType], map: "idx_users_employmentType")
  @@map("users")
}

model UserPermission {
  id        String  @id @default(cuid())
  userId    String
  resource  String
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource])
  @@index([resource], map: "idx_user_permissions_resource")
  @@map("user_permissions")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "idx_accounts_userId")
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_sessions_userId")
  @@index([expires], map: "idx_sessions_expires")
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires], map: "idx_verification_tokens_expires")
  @@map("verification_tokens")
}

model Client {
  id                String          @id @default(cuid())
  name              String
  phone             String
  email             String?
  birthDate         DateTime?
  photoUrl          String?
  isActive          Boolean         @default(true)
  faceShape         String?
  aiAnalysedAt      DateTime?
  homeAddress       String?
  homeCity          String?
  homeZipCode       String?
  homeLat           Float?
  homeLng           Float?
  cashbackBalance   Float           @default(0)
  loyaltyPoints     Int             @default(0)
  loyaltyLevel      LoyaltyLevel    @default(BRONZE)
  segment           ClientSegment   @default(NEW)
  avgVisitInterval  Int?
  lastVisitAt       DateTime?
  totalSpent        Float           @default(0)
  totalAtendimentos Int             @default(0)
  ticketMedio       Float           @default(0)
  favoritoCorte     String?
  favoritoProduto   String?
  establishmentId   String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  appointments      Appointment[]
  establishment     Establishment   @relation(fields: [establishmentId], references: [id])
  loyaltyAccount    LoyaltyAccount?
  homeNumber        String?
  homeNeighborhood  String?
  productSales      ProductSale[]
  subscription      Subscription?

  @@unique([phone, establishmentId])
  @@index([establishmentId, isActive], map: "idx_clients_establishmentId_isActive")
  @@index([establishmentId, name], map: "idx_clients_establishmentId_name")
  @@index([establishmentId, createdAt], map: "idx_clients_establishmentId_createdAt")
  @@index([segment], map: "idx_clients_segment")
  @@index([loyaltyLevel], map: "idx_clients_loyaltyLevel")
  @@index([lastVisitAt], map: "idx_clients_lastVisitAt")
  @@map("clients")
}

model Service {
  id              String        @id @default(cuid())
  name            String
  description     String?
  price           Float
  durationMin     Int
  category        String?
  photoUrl        String?
  isActive        Boolean       @default(true)
  availableHome   Boolean       @default(false)
  establishmentId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  appointments    Appointment[]
  userServices    UserService[]
  haircuts        Haircut[]
  establishment   Establishment @relation(fields: [establishmentId], references: [id])

  @@index([establishmentId, isActive], map: "idx_services_establishmentId_isActive")
  @@index([establishmentId, category], map: "idx_services_establishmentId_category")
  @@index([availableHome], map: "idx_services_availableHome")
  @@map("services")
}

model Haircut {
  id              String        @id @default(cuid())
  name            String
  description     String?
  photoUrl        String?
  instagramUrl    String?
  serviceId       String?
  instructions    String?
  durationMin     Int?
  difficulty      String?
  tags            String[]
  category        String?
  isActive        Boolean       @default(true)
  faceShapeCompat Json?
  establishmentId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  appointments    Appointment[]
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  service         Service?      @relation(fields: [serviceId], references: [id])

  @@index([establishmentId, isActive], map: "idx_haircuts_establishmentId_isActive")
  @@index([serviceId], map: "idx_haircuts_serviceId")
  @@index([category], map: "idx_haircuts_category")
  @@map("haircuts")
}

model Appointment {
  id              String            @id @default(cuid())
  status          AppointmentStatus @default(SCHEDULED)
  serviceType     ServiceType       @default(PRESENTIAL)
  scheduledAt     DateTime
  arrivedAt       DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  notes           String?
  clientAddress   String?
  clientCity      String?
  clientLat       Float?
  clientLng       Float?
  distanceKm      Float?
  travelFee       Float?
  clientId        String
  professionalId  String
  serviceId       String
  haircutId       String?
  establishmentId String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  client          Client            @relation(fields: [clientId], references: [id])
  establishment   Establishment     @relation(fields: [establishmentId], references: [id])
  haircut         Haircut?          @relation(fields: [haircutId], references: [id])
  professional    User              @relation(fields: [professionalId], references: [id])
  service         Service           @relation(fields: [serviceId], references: [id])
  payment         Payment?

  @@index([establishmentId, scheduledAt], map: "idx_appointments_establishmentId_scheduledAt")
  @@index([professionalId, scheduledAt], map: "idx_appointments_professionalId_scheduledAt")
  @@index([clientId, scheduledAt], map: "idx_appointments_clientId_scheduledAt")
  @@index([status, scheduledAt], map: "idx_appointments_status_scheduledAt")
  @@index([serviceId], map: "idx_appointments_serviceId")
  @@index([haircutId], map: "idx_appointments_haircutId")
  @@index([createdAt], map: "idx_appointments_createdAt")
  @@map("appointments")
}

model Payment {
  id      String        @id @default(cuid())
  method  PaymentMethod
  status  PaymentStatus @default(PENDING)
  amount  Float
  dueDate DateTime?

  pixQrCode    String?
  pixCopyPaste String?
  pixTxId      String?   @unique
  pixStatus    PixStatus @default(PENDING)
  pixPaidAt    DateTime?

  splitType         SplitType @default(SPLIT_ESTABLISHMENT)
  splitEstabAmount  Float?
  splitProfAmount   Float?
  cashbackGenerated Float     @default(0)

  appointmentId String      @unique
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  @@index([status, dueDate], map: "idx_payments_status_dueDate")
  @@index([method], map: "idx_payments_method")
  @@index([createdAt], map: "idx_payments_createdAt")
  @@index([pixStatus], map: "idx_payments_pixStatus")
  @@map("payments")
}

model CashRegister {
  id              String        @id @default(cuid())
  openedAt        DateTime      @default(now())
  closedAt        DateTime?
  openingAmount   Float         @default(0)
  closingAmount   Float?
  totalRevenue    Float         @default(0)
  totalExpenses   Float         @default(0)
  notes           String?
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  transactions    Transaction[]

  @@index([establishmentId, openedAt], map: "idx_cash_registers_establishmentId_openedAt")
  @@index([closedAt], map: "idx_cash_registers_closedAt")
  @@map("cash_registers")
}

model Transaction {
  id             String       @id @default(cuid())
  type           String
  amount         Float
  description    String?
  method         String?
  createdAt      DateTime     @default(now())
  cashRegisterId String
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id])

  @@index([cashRegisterId, createdAt], map: "idx_transactions_cashRegisterId_createdAt")
  @@index([type, createdAt], map: "idx_transactions_type_createdAt")
  @@index([method], map: "idx_transactions_method")
  @@map("transactions")
}

model Product {
  id              String          @id @default(cuid())
  name            String
  sku             String?
  barcode         String?
  costPrice       Float
  salePrice       Float
  stock           Int             @default(0)
  minStock        Int             @default(5)
  unit            String          @default("un")
  supplier        String?
  category        String?
  subCategory     String?
  hasAlcohol      Boolean         @default(false)
  photoUrl        String?
  isActive        Boolean         @default(true)
  establishmentId String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  sales           ProductSale[]
  establishment   Establishment   @relation(fields: [establishmentId], references: [id])
  stockMovements  StockMovement[]

  @@index([establishmentId, isActive], map: "idx_products_establishmentId_isActive")
  @@index([establishmentId, name], map: "idx_products_establishmentId_name")
  @@index([category], map: "idx_products_category")
  @@index([stock], map: "idx_products_stock")
  @@index([barcode], map: "idx_products_barcode")
  @@index([sku], map: "idx_products_sku")
  @@map("products")
}

model StockMovement {
  id            String   @id @default(cuid())
  type          String
  quantity      Int
  reason        String?
  unitPrice     Float?
  appointmentId String?
  createdAt     DateTime @default(now())
  productId     String
  product       Product  @relation(fields: [productId], references: [id])

  @@index([productId, createdAt], map: "idx_stock_movements_productId_createdAt")
  @@index([appointmentId], map: "idx_stock_movements_appointmentId")
  @@index([type, createdAt], map: "idx_stock_movements_type_createdAt")
  @@index([createdAt], map: "idx_stock_movements_createdAt")
  @@map("stock_movements")
}

model ProductSale {
  id        String   @id @default(cuid())
  quantity  Int      @default(1)
  unitPrice Float
  total     Float
  createdAt DateTime @default(now())
  productId String
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@index([productId, createdAt], map: "idx_product_sales_productId_createdAt")
  @@index([clientId, createdAt], map: "idx_product_sales_clientId_createdAt")
  @@index([createdAt], map: "idx_product_sales_createdAt")
  @@map("product_sales")
}

model KitItem {
  id          String   @id @default(cuid())
  name        String
  quantity    Int      @default(0)
  minQuantity Int      @default(1)
  unit        String   @default("un")
  notes       String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_kit_items_userId")
  @@map("kit_items")
}

model LoyaltyAccount {
  id             String               @id @default(cuid())
  totalEarned    Float                @default(0)
  totalRedeemed  Float                @default(0)
  currentBalance Float                @default(0)
  totalPoints    Int                  @default(0)
  level          LoyaltyLevel         @default(BRONZE)
  expiresAt      DateTime?
  clientId       String               @unique
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  client         Client               @relation(fields: [clientId], references: [id])
  transactions   LoyaltyTransaction[]

  @@index([level], map: "idx_loyalty_accounts_level")
  @@index([expiresAt], map: "idx_loyalty_accounts_expiresAt")
  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id               String          @id @default(cuid())
  type             String
  amount           Float
  description      String?
  servicoBase      Float?
  servicoRate      Float?
  produtoBase      Float?
  produtoRate      Float?
  createdAt        DateTime        @default(now())
  loyaltyAccountId String
  cashbackConfigId String?
  loyaltyAccount   LoyaltyAccount  @relation(fields: [loyaltyAccountId], references: [id])
  cashbackConfig   CashbackConfig? @relation(fields: [cashbackConfigId], references: [id])

  @@index([loyaltyAccountId, createdAt], map: "idx_loyalty_transactions_loyaltyAccountId_createdAt")
  @@index([cashbackConfigId], map: "idx_loyalty_transactions_cashbackConfigId")
  @@index([type, createdAt], map: "idx_loyalty_transactions_type_createdAt")
  @@map("loyalty_transactions")
}

model SubscriptionPlan {
  id              String         @id @default(cuid())
  name            String
  description     String?
  price           Float
  cortesIncluidos Int            @default(4)
  atendedomicilio Boolean        @default(false)
  services        String[]
  isActive        Boolean        @default(true)
  establishmentId String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  establishment   Establishment  @relation(fields: [establishmentId], references: [id])
  subscriptions   Subscription[]

  @@index([establishmentId, isActive], map: "idx_subscription_plans_establishmentId_isActive")
  @@map("subscription_plans")
}

model Subscription {
  id            String             @id @default(cuid())
  status        SubscriptionStatus @default(ACTIVE)
  price         Float
  startedAt     DateTime           @default(now())
  nextBillingAt DateTime
  cortesUsados  Int                @default(0)
  mesReferencia String?
  pausedAt      DateTime?
  cancelledAt   DateTime?
  notes         String?
  clientId      String             @unique
  planId        String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  client        Client             @relation(fields: [clientId], references: [id])
  plan          SubscriptionPlan   @relation(fields: [planId], references: [id])

  @@index([planId], map: "idx_subscriptions_planId")
  @@index([status, nextBillingAt], map: "idx_subscriptions_status_nextBillingAt")
  @@index([mesReferencia], map: "idx_subscriptions_mesReferencia")
  @@map("subscriptions")
}

model GiftCard {
  id         String    @id @default(cuid())
  code       String    @unique
  amount     Float
  balance    Float
  isUsed     Boolean   @default(false)
  expiresAt  DateTime?
  redeemedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([isUsed], map: "idx_gift_cards_isUsed")
  @@index([expiresAt], map: "idx_gift_cards_expiresAt")
  @@map("gift_cards")
}

model PricingRule {
  id              String        @id @default(cuid())
  name            String
  description     String?
  isActive        Boolean       @default(true)
  markupPct       Float         @default(0)
  discountPct     Float         @default(0)
  daysOfWeek      Int[]
  startTime       String?
  endTime         String?
  establishmentId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  establishment   Establishment @relation(fields: [establishmentId], references: [id])

  @@index([establishmentId, isActive], map: "idx_pricing_rules_establishmentId_isActive")
  @@map("pricing_rules")
}

model CashbackConfig {
  id              String               @id @default(cuid())
  servicos        Float                @default(7)
  domicilio       Float                @default(5)
  produtos        Float                @default(3)
  assinaturas     Float                @default(10)
  establishmentId String
  createdAt       DateTime             @default(now())
  establishment   Establishment        @relation(fields: [establishmentId], references: [id])
  transactions    LoyaltyTransaction[]

  @@index([establishmentId, createdAt], map: "idx_cashback_configs_establishmentId_createdAt")
  @@map("cashback_configs")
}

model UserSchedule {
  id        String  @id @default(cuid())
  userId    String
  dayOfWeek Int
  startTime String
  endTime   String
  isActive  Boolean @default(true)
  user      User    @relation(fields: [userId], references: [id])

  @@unique([userId, dayOfWeek])
  @@index([dayOfWeek, isActive], map: "idx_user_schedules_dayOfWeek_isActive")
  @@map("user_schedules")
}

model UserService {
  userId    String
  serviceId String
  user      User    @relation(fields: [userId], references: [id])
  service   Service @relation(fields: [serviceId], references: [id])

  @@id([userId, serviceId])
  @@index([serviceId], map: "idx_user_services_serviceId")
  @@map("user_services")
}

model Organization {
  id         String  @id @default(cuid())
  name       String
  legalName  String?
  cnpj       String? @unique
  email      String?
  phone      String?
  ownerName  String?
  ownerEmail String?
  ownerPhone String?

  logoUrl       String?

  isActive      Boolean       @default(true)
  isBlocked     Boolean       @default(false)
  billingStatus BillingStatus @default(ACTIVE)

  planId       String?
  trialEndsAt  DateTime?
  lastAccessAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan           PlanDefinition?            @relation(fields: [planId], references: [id])
  establishments Establishment[]
  users          User[]
  subscriptions  OrganizationSubscription[]
  invoices       OrganizationInvoice[]
  usageMetrics   UsageMetric[]
  storageUsage   StorageUsage?

  @@index([isActive, isBlocked], map: "idx_organizations_isActive_isBlocked")
  @@index([billingStatus], map: "idx_organizations_billingStatus")
  @@index([planId], map: "idx_organizations_planId")
  @@map("organizations")
}

model PlanDefinition {
  id           String  @id
  name         String
  description  String?
  priceMonthly Float   @map("price_monthly")

  maxEstablishments Int? @map("max_establishments")
  maxUsers          Int? @map("max_users")
  maxClients        Int? @map("max_clients")
  maxAppointments   Int? @map("max_appointments")
  maxStorageMb      Int? @map("max_storage_mb")

  features Json?
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organizations Organization[]
  subscriptions OrganizationSubscription[]

  @@index([isActive], map: "idx_plan_definitions_isActive")
  @@map("plan_definitions")
}

model OrganizationSubscription {
  id String @id @default(cuid())

  organizationId String @map("organization_id")
  planId         String @map("plan_id")

  status BillingStatus @default(ACTIVE)
  price  Float

  billingDay    Int       @default(5) @map("billing_day")
  startedAt     DateTime  @default(now()) @map("started_at")
  nextBillingAt DateTime? @map("next_billing_at")
  lastPaidAt    DateTime? @map("last_paid_at")
  cancelledAt   DateTime? @map("cancelled_at")

  provider   String? // manual, mercado_pago, stripe, asaas etc.
  externalId String? @map("external_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         PlanDefinition @relation(fields: [planId], references: [id])

  @@index([organizationId], map: "idx_org_subscriptions_organizationId")
  @@index([planId], map: "idx_org_subscriptions_planId")
  @@index([status, nextBillingAt], map: "idx_org_subscriptions_status_nextBillingAt")
  @@map("organization_subscriptions")
}

model OrganizationInvoice {
  id String @id @default(cuid())

  organizationId String        @map("organization_id")
  status         InvoiceStatus @default(PENDING)

  amount      Float
  dueDate     DateTime  @map("due_date")
  paidAt      DateTime? @map("paid_at")
  cancelledAt DateTime? @map("cancelled_at")

  referenceMonth String  @map("reference_month") // Ex: 2026-05
  provider       String?
  externalId     String? @map("external_id")

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, referenceMonth], map: "idx_org_invoices_organizationId_referenceMonth")
  @@index([status, dueDate], map: "idx_org_invoices_status_dueDate")
  @@map("organization_invoices")
}

model UsageMetric {
  id String @id @default(cuid())

  organizationId  String  @map("organization_id")
  establishmentId String? @map("establishment_id")

  metric         String
  value          Int    @default(0)
  referenceMonth String @map("reference_month") // Ex: 2026-05

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, establishmentId, metric, referenceMonth], map: "uq_usage_metric_org_estab_metric_month")
  @@index([organizationId, referenceMonth], map: "idx_usage_metrics_organizationId_referenceMonth")
  @@index([metric], map: "idx_usage_metrics_metric")
  @@map("usage_metrics")
}

model StorageUsage {
  id String @id @default(cuid())

  organizationId String @unique @map("organization_id")

  totalFiles  Int   @default(0) @map("total_files")
  totalSizeMb Float @default(0) @map("total_size_mb")

  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("storage_usage")
}

